# Node dependencies
**/node_modules/

# Python caches and virtual environments
**/__pycache__/
**/*.pyc
**/.venv/
**/venv/

# Runtime data and logs
parent-dashboard/server-ts/data/
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
*.log
*.log.*
pi-agent/agent/warning_counts.json
windows-app/watchdog/kill_attempts.txt

# Local machine and deployment configuration
windows-app/config/guard_runtime.json
windows-app/config/local-agent-config*.json
pi-agent/agent/config.json
**/.guardian-shield/

# Certificates, private keys, and other local credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*secrets*

# Environment secrets
parent-dashboard/server-ts/.env
windows-app/.live-agent-venv/

# Frontend build output
**/dist/
**/build/

# Local test captures and generated artifacts
/guardian_wayland_test.png
/latest_aman_test.jpg
**/screenshots/
**/captures/

# SSH data pulls (TRANSFER-DATA.bat / GUARD.bat datapull). These folders are the
# child's actual browsing, app and YouTube records copied off the Pi — the most
# sensitive data this project handles. They must never reach a remote.
data-exports/
**/guardian-export-*.tar.gz

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
