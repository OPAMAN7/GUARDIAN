  "cards": [
    {
      "dot": "cyan",
      "title": "Every Dashboard Tab",
      "items": [
        "Live View: screen mirror, telemetry, stream FPS, quality, width, fit, zoom, brightness, contrast",
        "Devices: registered device status and last-seen management",
        "Apps: active app controls plus Live Running, Installed, Blocked Rules, Message History",
        "Progress: academic activity, trends, breakdowns, goals, rules, and AI insight",
        "Blocklist: custom blocked websites",
        "Rules & Limits: category switches and custom URL rules",
        "Alerts: alert history and mark-all-read"
      ]
    },
    {
      "dot": "rose",
      "title": "What an App Click Does",
      "items": [
        "The selected device is required before a remote action is sent",
        "Close, timer, message, and block actions use authenticated REST endpoints",
        "The server resolves the device Socket.IO connection and emits the Pi command",
        "The agent runs the operation off the read loop, then reports state back"
      ]
    },
    {
      "dot": "orange",
      "title": "Screen Mirroring Is Separate but Connected",
      "items": [
        "The Pi captures frames and sends screenshots to the server",
        "The server persists selected frames, caches the latest frame, and broadcasts live_screenshot",
        "Live View paints the selected device frame and can open an Output Controller window",
        "Presentation mode is an optional display surface, not keyboard or mouse injection"
      ]
    }
  ]
